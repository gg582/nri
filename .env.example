# Provider selection (openai | gemini | kimi | deepseek | grok | claude)
NRI_PROVIDER=openai
# Optional model override
# NRI_MODEL=gpt-4o

# API keys (set only the ones you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
KIMI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# Optional endpoint overrides
# KIMI_BASE_URL=https://api.moonshot.ai/v1

# Test execution
# NRI_TEST_MODE=mock            # mock | (unset = MCP or shell runner)
# NRI_TEST_COMMAND=npm test -- --coverage
# NRI_WORKSPACE=.nri-workspace

# MCP coverage tool submodule (takes precedence over the shell runner)
# NRI_MCP_SERVER_COMMAND=npx
# NRI_MCP_SERVER_ARGS=-y your-coverage-mcp-server
# NRI_MCP_TOOL=measure_coverage
