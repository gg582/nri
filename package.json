    "@langchain/google-genai": "^0.2.16",
    "@langchain/langgraph": "^0.2.66",
    "@langchain/openai": "^0.5.10",
    "@langchain/xai": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
