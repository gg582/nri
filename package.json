{
  "name": "@gg582/nri",
  "version": "0.1.2",
  "description": "Adaptive agentic engineering harness: triage-routed dual-path (FAST/HEAVY) agent with business-logic pre-flight validation, abstract-graph planning, coverage-driven loops and self-applying diffs. Built on LangGraph.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "nri": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gg582/nri.git"
  },
  "homepage": "https://github.com/gg582/nri#readme",
  "bugs": "https://github.com/gg582/nri/issues",
  "keywords": [
    "ai-agent",
    "agent-harness",
    "langgraph",
    "llm",
    "code-generation",
    "refactoring",
    "multi-provider",
    "mcp"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@langchain/anthropic": "^0.3.20",
